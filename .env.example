# Aktif ortam — prod | staging | dev | local
NADIRGOLD_ENV=prod

# Ortam URL'leri
BASE_URL_PROD=https://www.nadirgold.work
BASE_URL_STAGING=https://staging.nadirgold.work
BASE_URL_DEV=https://dev.nadirgold.work
BASE_URL_LOCAL=http://localhost:3000

# (Opsiyonel) API host override — boşsa baseURL'den otomatik türetilir
# API_HOST_PROD=https://api.nadirgold.work

# Prod'da yıkıcı test koşmak için "1" set'le. Default: 0 (kapalı, guard aktif).
ALLOW_PROD_ORDERS=0

# Genel test kullanıcı
TEST_EMAIL=your_email@example.com
TEST_PASSWORD=your_password

# Env-spesifik kullanıcı (varsa öncelikli)
# TEST_EMAIL_DEV=
# TEST_PASSWORD_DEV=

# Google OAuth
GOOGLE_EMAIL=
GOOGLE_PASSWORD=

# Legacy (geriye uyum için)
DEV_URL=https://www.nadirgold.work
LOGIN_URL=https://www.nadirgold.work/hesap/giris
